# BarberFlow Environment Variables Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or real credentials to version control.

# Supabase Public Integration (Safe for browser code)
# Replace these with your actual Supabase project settings from:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key-here

# Multi-Tenant & App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BarberFlow

# Security Notice:
# SUPABASE_SERVICE_ROLE_KEY is strictly server-only and should NEVER
# have a NEXT_PUBLIC_ prefix or be exposed to client-side code.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key-here
